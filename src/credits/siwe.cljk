(ns credits.siwe
  "SIWE ログイン判定（appview 側 adapter）。人間認証ポリシーの wallet 規則を
  map API で判定。セマンティクスの正本は aiueos/credits_siwe.cljk（itonami dapp
  bundle、`amu test` が jvm-kir / js / wasm で同じ fixture を実行）。parity
  fixture の数値は guest の test-* と一致。pure、副作用なし。")

(def error-bits
  {:domain 1
   :address 2
   :chain 4
   :nonce 8
   :expiry 16
   :version 32
   :method 64})

(defn siwe-judgment
  "各確認の成否（true/false）からエラービットを返す。未確認 = false = 拒否。"
  [{:keys [domain-ok addr-ok chain-ok nonce-ok exp-ok version-ok method-ok]}]
  (+ (if domain-ok 0 1)
     (if addr-ok 0 2)
     (if chain-ok 0 4)
     (if nonce-ok 0 8)
     (if exp-ok 0 16)
     (if version-ok 0 32)
     (if method-ok 0 64)))

(defn pkh-binding
  "did:pkh の結合判定（1/0）。address 一致・chain・method が揃うときだけ 1。"
  [{:keys [addr-ok chain-ok method-ok]}]
  (if (and addr-ok chain-ok method-ok) 1 0))
