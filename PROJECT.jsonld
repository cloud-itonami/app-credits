{
  "@context": "https://schema.org",
  "@type": "Project",
  "name": "Etzhayyim Computing Credits (GCC)",
  "identifier": "etzhayyim-project-credits",
  "description": "ATP-like computing resource currency for the Etzhayyim Organism. Manages credit balances, purchase fee settlement, and public-fund routing for credit spend.",
  "hasPart": [
    {
      "@type": "WebApplication",
      "name": "Credits API",
      "url": "https://credits.etzhayyim.com"
    },
    {
      "@type": "WebApplication",
      "name": "Credits Console",
      "url": "https://credits.etzhayyim.com/",
      "description": "Preview console for 30% purchase fee and 10% public-fund allocation routing."
    }
  ],
  "rdfUnifiedDocuments": {
    "@type": "Dataset",
    "name": "Unified top-level RDF/JSON-LD documents",
    "description": "Consolidated from project top-level *.jsonld files except PROJECT.jsonld.",
    "documents": [
      {
        "fileName": "scheduler.jsonld",
        "content": {
          "@context": [
            "https://schema.org/",
            {
