{
  "name": "kotodama-a5ce95af",
  // Compiled from src/credits/mcp_worker.cljs by shadow-cljs (:target :esm,
  // build :credits-worker). Before the cljs migration this pointed at a
  // SvelteKit build output that is not committed anywhere in this tree, and
  // the TypeScript a reader opened (src/app.ts) was in no bundle at all --
  // see docs/adr/0001.
  "main": "../../dist/credits/worker.js",
  "compatibility_date": "2025-03-17",
  // nodejs_compat / nodejs_als were adapter-cloudflare's requirement. The cljs
  // bundle imports no node: builtin and uses only Web-standard APIs
  // (Request/Response/URL/fetch/JSON/Object). Verified: see
  // docs/operator-quickstart.md S7.
  "vars": {
    "APP_CAPABILITIES": "[\"bpmn-dispatch\",\"credit-ledger\",\"reward-management\"]",
    "APP_DESCRIPTION": "Credits Mcp — AI Agent",
    "APP_DISPLAY_NAME": "Credits Mcp",
    "APP_EMBED_URL": "https://a5ce95af.etzhayyim.com/?embed=1",
    "APP_FRAMEWORK": "cljs-esm-worker",
    "AGENTGATEWAY_MCP_ROUTER_URL": "https://mcp.etzhayyim.com/xrpc/com.etzhayyim.mcp.message",
    "APP_NANOID": "a5ce95af",
    "APP_PERFORMER_TYPE": "service",
    "APP_UI_TYPE": "appview"
  },
  "routes": [
    {
      "pattern": "a5ce95af.etzhayyim.com/*",
      "zone_name": "etzhayyim.com"
    },
    {
      "pattern": "credits.etzhayyim.com/*",
      "zone_name": "etzhayyim.com"
    }
  ]
}
